# Konfiguracja aplikacji. Skopiuj do .env i uzupełnij.
# UWAGA: .env zawiera sekrety — trzymaj z uprawnieniami 600 i nigdy nie commituj.

# Adres nasłuchu.
#  - lokalnie / systemd (za Caddy na tym samym hoście): 127.0.0.1:8080
#  - Docker Compose: nadpisywane na 0.0.0.0:8080 (nie zmieniaj tutaj)
LISTEN_ADDR=127.0.0.1:8080

# Ścieżki danych (w Dockerze nadpisywane na /data/app.db i /data)
DB_PATH=./data/app.db
DATA_DIR=./data

# Sekrety — wygeneruj: openssl rand -base64 32
APP_SECRET_KEY=
SESSION_SECRET=

# SMTP — relay uczelniany. Dwa warianty:
#  - bez uwierzytelnienia (typowe w sieci UW): zostaw SMTP_USER/SMTP_PASS puste
#  - z uwierzytelnieniem + STARTTLS: uzupełnij SMTP_USER i SMTP_PASS
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=wyniki@example.org

# Nazwa jednostki w tematach/treści maili (cudzysłowy gdy zawiera spacje)
ORG_NAME="Gluchoniemcy"

# Retencja i limity
FILE_RETENTION_HOURS=72
MAX_UPLOAD_MB=25
MAX_JOBS_PER_DAY=200

# Adres publiczny dla Caddy (tylko Docker Compose). Przykłady:
#  - publiczna domena:  genetyka.wydzial.uw.edu.pl   (Let's Encrypt automatycznie)
#  - sieć wewnętrzna:   https://host.wewnetrzny       (wymaga `tls internal` w Caddyfile)
SITE_ADDRESS=
